#!/bin/bash

shopt -s extglob

#Color variables:
# https://gist.github.com/JBlond/2fea43a3049b38287e5e9cefc87b2124
RED='\e[31m'
GREEN='\e[32m'
YELLOW='\e[33m'
BLUE='\e[34m'
WHITE='\e[37m'
PURPLE='\e[35m'
BOLD='\e[1m'
RESET='\e[0m'

# Llama-cli Commands for Reference:
# llama-cli --cache-list
# llama-cli -hf <HF_MODEL_NAME>

##################################################################
# To-Do:
#
# 1) Local MCP for personal notes with json config:
# Command:
#	llama-server \
#		-hf "$chosenLLM" \
#		--mcp-servers-config "/home/<USER>/mcp/<MCP_CONFIG>.json" \
#		--ui-mcp-proxy \
#		--jinja \
#		-c 16384 \
#		--port 8080
#
# 2) Local MCP server (node/lua(?)) with containerized deployment
#
##################################################################

chosenLLM=''
runSel=''

readarray -t llmArr < <(echo "$(llama-cli --cache-list | grep '[0-9]\.' | sed 's/^\s*[0-9]\+\.\s//g')")

llm_run() {

	clear

	if [[ ! -z $llmArr ]]; then
	        
		printf "\n"
		printf "${BLUE}::::::::::::::::::::::::::::::::::::::::::::::::::::::::::${RESET}\n"
		printf "${BLUE}::${RESET} ${WHITE}Downloaded Models: ${RESET}\n"
		printf "${BLUE}::::::::::::::::::::::::::::::::::::::::::::::::::::::::::${RESET}\n"
		printf "\n"
		
		while [[ -z $chosenLLM ]]; do
	                for ind in "${!llmArr[@]}"; do
	                        (( runInd = ind + 1 ))
				printf "${BLUE}:: ${runInd})${RESET} ${WHITE}${llmArr[$ind]}${RESET}\n"
	
	                        if [[ -z $runPat ]]; then
	                                runPat="${runInd}"
	                        else
	                                runPat="${runPat}|${runInd}"
	                        fi
	
	                done
	
	                if (( "${#llmArr[@]}" > 1 )); then
	                        read -p "::: Enter your choice [1-${runInd}]: " runSel
	                else
	                        read -p "::: Enter your choice [1]: " runSel
	                fi
	
	                case $runSel in
	                        @($runPat))
	                                (( arrInd = runSel - 1 ))
	                                read -ra runPart <<< "${llmArr[$arrInd]}"
	                                chosenLLM="${runPart[0]}"
					;;
	                        *)
	                                printf "${RED}>>> NOPE:${RESET} ${WHITE}Please choose a model to run.${RESET}\n"
	                                choseLLM=''
					;;
	                esac
	        done
	else
	        printf "${RED}>>> ERROR:${RESET} ${WHITE}There are no locally cached models.${RESET}\n"
	        exit 1
	fi
	
	if [[ ! -z $chosenLLM ]]; then
		llama-server \
			-hf "$chosenLLM" \
			--jinja \
			-c 16384 \
			--port 9931 & 
		
		(sleep 10 && xdg-open "http://127.0.0.1:9931") & wait
	fi
}


llm_run
